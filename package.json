{
  "name": "pulerauto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLMM LP discovery, evaluation and monitoring (Solana + EVM)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "invariants": "tsx src/scripts/check-invariants.ts",
    "indexer": "tsx src/indexer/run.ts",
    "swaps:backfill": "tsx src/scripts/backfill-swaps.ts",
    "swaps:check": "tsx src/scripts/check-fee-segments.ts",
    "ticks:capture-fixture": "tsx src/scripts/capture-tick-fixture.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
